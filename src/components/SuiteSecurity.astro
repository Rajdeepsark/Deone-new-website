---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

interface Feature {
  icon: IconName;
  title: string;
  description: string;
}

interface Placement {
  left: number;
  top: number;
  width: number;
}

interface Tab {
  label: string;
  image?: string;
  imageAlt?: string;
  imagePlacement?: Placement;
  features: Feature[];
}

interface Props {
  eyebrow: string;
  headline: string;
  subtext: string;
  tabs: Tab[];
}

const { eyebrow, headline, subtext, tabs } = Astro.props;

// Picture placements are measured in the design frame. There the panel that holds the
// list and the picture starts 240px from the left and 626px from the top, 1032px wide.
const PANEL = { left: 240, top: 626, width: 1032 };
const DEFAULT_PLACEMENT: Placement = { left: 811, top: 562, width: 687.56 };

const place = ({ left, top, width }: Placement = DEFAULT_PLACEMENT) =>
  [
    `--x:${(((left - PANEL.left) / PANEL.width) * 100).toFixed(2)}%`,
    `--y:${top - PANEL.top}px`,
    `--w:${((width / PANEL.width) * 100).toFixed(2)}%`,
  ].join(";");

const id = (kind: string, index: number) => `security-${kind}-${index}`;
---

<section
  class="relative isolate overflow-hidden bg-gradient-to-b from-blush-light to-[#f9e5db] px-6 py-24 text-brand-ink md:py-[160px]"
  data-security
>
  <header class="mx-auto max-w-[600px] text-center">
    <p
      class="font-serif text-[16px] leading-[22px] font-medium uppercase tracking-[0.08em] md:text-[18px]"
    >
      {eyebrow}
    </p>

    <h2
      class="mt-6 font-sans text-[28px] leading-[1.214] font-normal uppercase tracking-[0.02em] md:text-[42px]"
    >
      {headline}
    </h2>

    <p
      class="mx-auto mt-7 max-w-[488px] font-sans text-[16px] font-normal leading-[27px] tracking-[0.01em]"
    >
      {subtext}
    </p>
  </header>

  <div class="mx-auto mt-16 flex max-w-[1032px] flex-col items-center lg:mt-[120px]">
    <div
      class="flex w-full max-w-[418px] gap-1 rounded-lg bg-brand-sand p-1 ring-1 ring-inset ring-brand-ink/[0.04]"
      role="tablist"
      aria-label={headline}
    >
      {tabs.map((tab, i) => (
        <button
          type="button"
          class="h-11 flex-1 rounded-lg px-6 font-sans text-[12px] leading-[15px] font-medium uppercase tracking-[0.13em] outline-none transition-colors duration-300 hover:bg-brand-ink/5 focus-visible:ring-1 focus-visible:ring-brand-ink aria-selected:bg-brand-copper aria-selected:text-brand-sand"
          role="tab"
          id={id("tab", i)}
          aria-controls={id("panel", i)}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {tabs.map((tab, i) => (
      <div
        class="relative mt-16 w-full"
        role="tabpanel"
        id={id("panel", i)}
        aria-labelledby={id("tab", i)}
        hidden={i !== 0}
      >
        {tab.image && (
          <img
            src={tab.image}
            alt={tab.imageAlt}
            class="pointer-events-none mx-auto -mt-8 mb-2 w-[78%] max-w-[420px] select-none lg:absolute lg:left-[calc(var(--x)_-_3%)] lg:top-[var(--y)] lg:-z-10 lg:m-0 lg:w-[calc(var(--w)_*_0.84)] lg:max-w-none xl:left-[var(--x)] xl:w-[var(--w)]"
            style={place(tab.imagePlacement)}
            loading="lazy"
            decoding="async"
          />
        )}

        <div
          class="lg:relative lg:h-[714px] lg:w-[504px] lg:overflow-hidden lg:[mask-image:linear-gradient(180deg,transparent_0,#000_33.61%,#000_55.88%,transparent_100%)]"
        >
          <!-- On wide screens every box gets a 198px row, so the list moves in even steps. -->
          <ol
            class="flex flex-col gap-6 transition-transform duration-[600ms] ease-[cubic-bezier(0.65,0,0.35,1)] motion-reduce:transition-none lg:absolute lg:inset-x-0 lg:top-[200px] lg:grid lg:auto-rows-[198px] lg:items-start lg:-translate-y-[var(--offset,0px)]"
            data-track
          >
            {tab.features.map((feature, n) => (
              <li
                class="group/feature flex cursor-pointer flex-col gap-6 rounded-lg bg-brand-cream p-6 ring-1 ring-inset ring-brand-copper/40 transition-[background-color,box-shadow] duration-[600ms] lg:bg-brand-cream/80 lg:ring-transparent lg:data-[active]:bg-brand-cream lg:data-[active]:ring-brand-copper/40"
                data-feature
                data-active={n === 0 ? "" : undefined}
              >
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-lg border border-brand-sand/10 bg-[linear-gradient(174.31deg,#C57847_39.64%,#F3E4DA_208.39%)] text-brand-sand transition-opacity duration-[600ms] lg:opacity-30 lg:group-data-[active]/feature:opacity-100"
                >
                  <Icon name={feature.icon} stroke={1.4} />
                </span>

                <div class="flex flex-col gap-4 transition-opacity duration-[600ms] lg:opacity-50 lg:group-data-[active]/feature:opacity-100">
                  <h3 class="font-sans text-[16px] leading-[22px] font-medium uppercase tracking-[0.03em]">
                    <button
                      type="button"
                      class="rounded-sm text-left uppercase outline-none focus-visible:ring-1 focus-visible:ring-brand-ink focus-visible:ring-offset-4 focus-visible:ring-offset-brand-cream"
                      aria-pressed={n === 0 ? "true" : "false"}
                    >
                      {feature.title}
                    </button>
                  </h3>

                  <p class="font-sans text-[14px] font-normal leading-6 tracking-[0.02em]">
                    {feature.description}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-security]").forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const next = (i + step + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });

    panels.forEach((panel) => {
      const track = panel.querySelector<HTMLElement>("[data-track]");
      const features = [...panel.querySelectorAll<HTMLElement>("[data-feature]")];
      if (!track) return;

      // The chosen box slides up into the clear band of the list; the rest fade around it.
      const activate = (index: number) => {
        features.forEach((feature, i) => {
          feature.toggleAttribute("data-active", i === index);
          feature.querySelector("button")?.setAttribute("aria-pressed", String(i === index));
        });
        const offset = features[index].offsetTop - features[0].offsetTop;
        track.style.setProperty("--offset", `${offset}px`);
      };

      features.forEach((feature, i) => feature.addEventListener("click", () => activate(i)));
    });
  });
</script>
