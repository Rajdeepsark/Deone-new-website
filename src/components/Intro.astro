---
interface Props {
  eyebrow?: string;
  headline?: string;
  subtext?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = "The world of DeOne",
  headline = "You Deserve Better",
  subtext = "A members-only experience, made to do more for you.",
  ctaLabel = "Enter the World",
  ctaHref = "#",
} = Astro.props;
---

<section class="relative isolate flex min-h-[560px] md:min-h-[720px] lg:min-h-[900px] items-center justify-center bg-brand-cream overflow-hidden py-16 md:py-0">
  <img
    src="/intro-pattern.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover object-center"
    loading="lazy"
    decoding="async"
  />

  <div class="mx-auto flex w-full max-w-[856px] flex-col items-center px-6 text-center">
    <p
      class="font-serif text-[18px] font-medium uppercase tracking-[0.08em] text-brand-ink"
    >
      {eyebrow}
    </p>

    <h2
      class="mt-4 font-sans text-[36px] leading-[1.15] font-normal uppercase tracking-[0.02em] text-brand-teal md:text-[42px]"
    >
      {headline}
    </h2>

    <p
      class="mt-5 max-w-[560px] font-sans text-[16px] font-normal leading-[1.7] tracking-[0.01em] text-brand-ink md:text-[18px]"
    >
      {subtext}
    </p>

    <a
      href={ctaHref}
      class="group mt-10 inline-flex h-11 w-[220px] items-center justify-center rounded-lg border border-cta-border transition-colors duration-300 hover:border-brand-teal"
    >
      <span class="inline-flex items-center text-brand-ink transition-colors duration-300 group-hover:text-brand-teal font-sans text-[12px] font-medium uppercase tracking-[0.13em]">
        <span>{ctaLabel}</span>
        <span aria-hidden="true" class="inline-flex items-center overflow-hidden max-w-0 opacity-0 transition-all duration-300 ease-out group-hover:max-w-[24px] group-hover:opacity-100 group-hover:ml-2">
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none">
            <path d="M0 8.5 H6 M8 8.5 H14" stroke="currentColor" stroke-width="1" />
            <path d="M11 4 L16 8.5 L11 13" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" stroke-linejoin="miter" />
          </svg>
        </span>
      </span>
    </a>
  </div>
</section>
