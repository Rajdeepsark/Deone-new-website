---
const columns = [
  {
    heading: "Suites",
    links: [
      { label: "Deluxe", href: "#" },
      { label: "Prestige", href: "/suites/prestige" },
      { label: "Executive", href: "#" },
    ],
  },
  {
    heading: "Services",
    links: [
      { label: "Banking", href: "#" },
      { label: "Wellness", href: "#" },
      { label: "Rewards", href: "#" },
    ],
  },
];

const socials = [
  { label: "LinkedIn", href: "#" },
  { label: "Instagram", href: "#" },
  { label: "X", href: "#" },
  { label: "YouTube", href: "#" },
];

const year = new Date().getFullYear();
---

<footer class="relative isolate bg-brand-teal text-brand-cream overflow-hidden">
  <!-- Background wave pattern (subtle diagonal lines) -->
  <img
    src="/footer-pattern.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
    loading="lazy"
    decoding="async"
  />


  <div class="relative mx-auto flex w-full max-w-[1032px] flex-col items-center px-6 pt-16 md:pt-32 lg:pt-40 pb-8 md:pb-12">
    <!-- Link columns — stacked on mobile (Figma mobile), spread horizontally from md+ -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-14 md:gap-[200px] lg:gap-[344px]">
      {columns.map((col) => (
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[18px] font-medium uppercase tracking-[0.08em] leading-none">
            {col.heading}
          </h3>
          <span aria-hidden="true" class="mt-6 h-px w-5 bg-brand-cream/70"></span>
          <ul class="mt-6 flex flex-col items-center gap-[24px]">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="font-sans text-[16px] font-medium uppercase tracking-[0.03em] leading-none hover:opacity-80"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- MOBILE: Download app row — curls are div blocks with proper CSS border-radius on inner corners -->
    <div class="md:hidden mt-20 py-10 relative w-full flex items-center justify-center">
      <div
        aria-hidden="true"
        class="absolute top-1/2 -translate-y-1/2 h-[140px] w-[56px] bg-brand-cream rounded-tr-[28px] rounded-br-[28px]"
        style="left: calc(50% - 50vw);"
      >
      </div>
      <p class="font-sans text-[14px] font-normal opacity-90">Download app</p>
      <div
        aria-hidden="true"
        class="absolute top-1/2 -translate-y-1/2 h-[140px] w-[56px] bg-brand-cream rounded-tl-[28px] rounded-bl-[28px]"
        style="right: calc(50% - 50vw);"
      >
      </div>
    </div>

    <!-- MOBILE: DEONE logo -->
    <div class="md:hidden mt-24">
      <svg viewBox="0 0 153 28" class="h-8 w-auto" fill="currentColor" aria-hidden="true">
        <path d="M21.5144 9.36398C21.0125 8.19821 20.319 7.21283 19.434 6.40514C18.5462 5.60014 17.51 4.98629 16.3254 4.5636C15.1408 4.1436 13.8537 3.93359 12.464 3.93359H0V22.7044H12.464C13.5703 22.7044 14.6146 22.5698 15.5995 22.2978C16.5844 22.0259 17.483 21.6274 18.3006 21.1024C19.1183 20.5774 19.8198 19.9367 20.4081 19.1828C20.9963 18.429 21.4524 17.5621 21.7789 16.5794C22.1027 15.5967 22.2673 14.5117 22.2673 13.319C22.2673 11.8463 22.0163 10.5271 21.5171 9.36129L21.5144 9.36398ZM17.5235 15.5428C17.313 16.1998 17.0216 16.7732 16.6546 17.2659C16.2849 17.7559 15.8505 18.1651 15.3513 18.4882C14.8494 18.814 14.307 19.0536 13.7187 19.2124C13.1305 19.3713 12.5287 19.4494 11.9135 19.4494H5.31857C4.72492 19.4494 4.2446 18.9701 4.2446 18.3778V8.27091C4.2446 7.6786 4.72492 7.19936 5.31857 7.19936H11.9135C12.6852 7.19936 13.43 7.32321 14.1397 7.56821C14.8521 7.81321 15.4889 8.19014 16.0502 8.69898C16.6114 9.20783 17.0513 9.84591 17.367 10.6186C17.6827 11.3913 17.8419 12.2932 17.8419 13.3271C17.8419 14.1509 17.7367 14.8913 17.5262 15.5482L17.5235 15.5428Z" />
        <path d="M33.0582 22.7068V3.93604H51.0809V7.19642H38.3741C37.7805 7.19642 37.3001 7.67565 37.3001 8.26796V11.6387H50.0285V14.7672H37.3001V18.3749C37.3001 18.9672 37.7805 19.4464 38.3741 19.4464H51.0809V22.7068H33.0582Z" />
        <path d="M134.958 22.7068V3.93604H152.981V7.19642H140.274C139.681 7.19642 139.2 7.67565 139.2 8.26796V11.6387H151.929V14.7672H139.2V18.3749C139.2 18.9672 139.681 19.4464 140.274 19.4464H152.981V22.7068H134.958Z" />
        <path d="M119.41 5.00783V17.6671L108.498 4.91629C107.964 4.29437 107.184 3.93359 106.363 3.93359H102.783V22.7044H105.557C106.15 22.7044 106.631 22.2251 106.631 21.6328V8.93321L117.57 21.7217C118.104 22.3463 118.884 22.7044 119.704 22.7044H123.285V3.93359H120.487C119.893 3.93359 119.413 4.41283 119.413 5.00514L119.41 5.00783Z" />
        <path d="M90.9607 13.0198C90.9095 9.5036 89.8625 0.126295 76.4892 0.0966797C63.1185 0.126295 62.0688 9.5036 62.0176 13.0198C62.0176 13.3536 62.0176 14.6486 62.0176 14.9825C62.0688 18.4986 63.1158 27.8759 76.4892 27.9055C89.8598 27.8759 90.9095 18.4986 90.9607 14.9825C90.9607 14.8209 90.9607 13.1274 90.9607 13.0198ZM86.2331 14.6782C86.2331 17.0609 85.7663 24.3705 76.4919 24.4809C67.2174 24.3705 66.7506 17.0609 66.7506 14.6782V13.324C66.7506 10.9413 67.2174 3.63168 76.4919 3.5213C85.7663 3.63168 86.2331 10.9413 86.2331 13.324V14.6782Z" />
      </svg>
    </div>

    <!-- DESKTOP: QR row with curls flush at viewport edges, all aligned on the same horizontal line -->
    <div class="hidden md:flex mt-[120px] lg:mt-[160px] relative w-full items-center justify-center py-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 -translate-y-1/2 h-[120px] lg:h-[150px] w-[120px] bg-brand-cream rounded-tr-[28px] rounded-br-[28px]"
        style="left: calc(50% - 50vw);"
      >
      </div>
      <img
        src="/footer-qr.svg"
        alt="Scan to download the DeOne app"
        class="h-[60px] w-[60px]"
        loading="lazy"
        decoding="async"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 -translate-y-1/2 h-[120px] lg:h-[150px] w-[120px] bg-brand-cream rounded-tl-[28px] rounded-bl-[28px]"
        style="right: calc(50% - 50vw);"
      >
      </div>
    </div>

    <!-- Social links row — MOBILE ONLY -->
    <ul class="md:hidden mt-40 flex items-center gap-6">
      {socials.map((s) => (
        <li>
          <a
            href={s.href}
            class="font-sans text-[12px] font-medium uppercase tracking-[0.13em] hover:opacity-80"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- MOBILE: copyright then globe icon -->
    <p class="md:hidden mt-8 font-sans text-[12px] font-normal tracking-[0.02em] opacity-90 text-center">
      © {year} DeOne. All rights reserved.
    </p>
    <button
      type="button"
      class="md:hidden mt-6 flex h-9 w-9 items-center justify-center rounded-md border border-brand-cream/40 hover:bg-brand-cream/10"
      aria-label="Change language"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="10" cy="10" r="8" />
        <path d="M2 10h16" />
        <path d="M10 2 Q6 10 10 18" />
        <path d="M10 2 Q14 10 10 18" />
      </svg>
    </button>

    <!-- DESKTOP: Bottom bar with copyright / DEONE / EN pill -->
    <div class="hidden md:grid mt-[120px] lg:mt-[160px] grid-cols-3 w-full items-center gap-4">
      <p class="font-sans text-[12px] font-normal tracking-[0.02em] opacity-90 justify-self-start">
        © {year} DeOne. All rights reserved.
      </p>

      <div class="justify-self-center">
        <svg viewBox="0 0 153 28" class="h-8 w-auto" fill="currentColor" aria-hidden="true">
          <path d="M21.5144 9.36398C21.0125 8.19821 20.319 7.21283 19.434 6.40514C18.5462 5.60014 17.51 4.98629 16.3254 4.5636C15.1408 4.1436 13.8537 3.93359 12.464 3.93359H0V22.7044H12.464C13.5703 22.7044 14.6146 22.5698 15.5995 22.2978C16.5844 22.0259 17.483 21.6274 18.3006 21.1024C19.1183 20.5774 19.8198 19.9367 20.4081 19.1828C20.9963 18.429 21.4524 17.5621 21.7789 16.5794C22.1027 15.5967 22.2673 14.5117 22.2673 13.319C22.2673 11.8463 22.0163 10.5271 21.5171 9.36129L21.5144 9.36398ZM17.5235 15.5428C17.313 16.1998 17.0216 16.7732 16.6546 17.2659C16.2849 17.7559 15.8505 18.1651 15.3513 18.4882C14.8494 18.814 14.307 19.0536 13.7187 19.2124C13.1305 19.3713 12.5287 19.4494 11.9135 19.4494H5.31857C4.72492 19.4494 4.2446 18.9701 4.2446 18.3778V8.27091C4.2446 7.6786 4.72492 7.19936 5.31857 7.19936H11.9135C12.6852 7.19936 13.43 7.32321 14.1397 7.56821C14.8521 7.81321 15.4889 8.19014 16.0502 8.69898C16.6114 9.20783 17.0513 9.84591 17.367 10.6186C17.6827 11.3913 17.8419 12.2932 17.8419 13.3271C17.8419 14.1509 17.7367 14.8913 17.5262 15.5482L17.5235 15.5428Z" />
          <path d="M33.0582 22.7068V3.93604H51.0809V7.19642H38.3741C37.7805 7.19642 37.3001 7.67565 37.3001 8.26796V11.6387H50.0285V14.7672H37.3001V18.3749C37.3001 18.9672 37.7805 19.4464 38.3741 19.4464H51.0809V22.7068H33.0582Z" />
          <path d="M134.958 22.7068V3.93604H152.981V7.19642H140.274C139.681 7.19642 139.2 7.67565 139.2 8.26796V11.6387H151.929V14.7672H139.2V18.3749C139.2 18.9672 139.681 19.4464 140.274 19.4464H152.981V22.7068H134.958Z" />
          <path d="M119.41 5.00783V17.6671L108.498 4.91629C107.964 4.29437 107.184 3.93359 106.363 3.93359H102.783V22.7044H105.557C106.15 22.7044 106.631 22.2251 106.631 21.6328V8.93321L117.57 21.7217C118.104 22.3463 118.884 22.7044 119.704 22.7044H123.285V3.93359H120.487C119.893 3.93359 119.413 4.41283 119.413 5.00514L119.41 5.00783Z" />
          <path d="M90.9607 13.0198C90.9095 9.5036 89.8625 0.126295 76.4892 0.0966797C63.1185 0.126295 62.0688 9.5036 62.0176 13.0198C62.0176 13.3536 62.0176 14.6486 62.0176 14.9825C62.0688 18.4986 63.1158 27.8759 76.4892 27.9055C89.8598 27.8759 90.9095 18.4986 90.9607 14.9825C90.9607 14.8209 90.9607 13.1274 90.9607 13.0198ZM86.2331 14.6782C86.2331 17.0609 85.7663 24.3705 76.4919 24.4809C67.2174 24.3705 66.7506 17.0609 66.7506 14.6782V13.324C66.7506 10.9413 67.2174 3.63168 76.4919 3.5213C85.7663 3.63168 86.2331 10.9413 86.2331 13.324V14.6782Z" />
        </svg>
      </div>

      <button
        type="button"
        class="justify-self-end flex h-8 items-center gap-1.5 rounded-md border border-brand-cream/40 bg-overlay-mid/10 px-2.5 text-[11px] font-medium uppercase tracking-[0.13em] hover:bg-overlay-mid/25"
        aria-label="Change language"
      >
        <span>EN</span>
        <svg width="8" height="5" viewBox="0 0 8 4" fill="none" aria-hidden="true">
          <path d="M1 0.5L4 3.5L7 0.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</footer>
