---
import SuiteSlider from "./SuiteSlider.astro";

interface Picture {
  image: string;
  alt: string;
}

interface Slide {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
}

interface Props {
  headline: string;
  subtext: string;
  gallery: Picture[];
  slides: Slide[];
}

const { headline, subtext, gallery, slides } = Astro.props;

// Each gallery picture, in gallery order: where it floats around the headline, and how
// it behaves while scrolling. All values are px at the design width.
//   phone - place and size in the phone design, a 402 x 729.5 frame from edge to edge
//   wide  - place and size in the desktop design, an 856 x 894 frame
//   blur  - softness at rest, as in the design
//   soft  - softness when fully out of focus
//   rise  - how far it travels upward, ahead of the page, while scrolling down
// The closer a picture appears, the more it softens and the further it rises.
const slots = [
  {
    phone: "left-[15.92%] top-[19.81%] w-[15.92%]",
    wide: "md:left-0 md:top-[14.9%] md:w-[10.4%]",
    blur: 4,
    soft: 10,
    rise: 70,
  },
  {
    phone: "right-[3.98%] top-0 w-[24.88%]",
    wide: "md:right-0 md:w-[17.76%]",
    blur: 0,
    soft: 12,
    rise: 110,
  },
  {
    phone: "bottom-0 left-0 w-[24.88%]",
    wide: "md:w-[28.04%]",
    blur: 0,
    soft: 14,
    rise: 150,
  },
  {
    phone: "right-[15.42%] top-[61.34%] w-[15.92%]",
    wide: "md:right-0 md:top-[58.6%] md:w-[10.4%]",
    blur: 4,
    soft: 10,
    rise: 90,
  },
];
---

<section
  class="[background:var(--suite-pictures-bg)] [--color-suite-ink:var(--suite-pictures-ink)] pb-24 pt-[62px] text-suite-ink md:pb-[240px] md:pt-[155px]"
>
  <div class="md:px-6">
    <div
      class="@container relative mx-auto aspect-[402/729.5] w-full max-w-[480px] md:aspect-[856/894] md:max-w-[856px]"
      data-gallery
    >
      {gallery.slice(0, slots.length).map((picture, i) => (
        <img
          src={picture.image}
          alt={picture.alt}
          class:list={[
            "absolute aspect-[240/313] rounded-tr-[12px] object-cover will-change-[filter,translate] [filter:blur(var(--blur))] [transition:translate_450ms_cubic-bezier(0.2,0.8,0.2,1),filter_450ms_cubic-bezier(0.2,0.8,0.2,1)] [translate:0_var(--shift,0px)] motion-reduce:transition-none md:rounded-tr-[24px]",
            slots[i].phone,
            slots[i].wide,
          ]}
          style={`--blur:${slots[i].blur}px`}
          loading="lazy"
          decoding="async"
          data-float
          data-blur={slots[i].blur}
          data-soft={slots[i].soft}
          data-rise={slots[i].rise}
        />
      ))}

      <h2
        class="absolute inset-x-0 top-[39.3%] text-center font-sans text-[clamp(28px,9.95cqw,48px)] leading-[1.1] font-light uppercase tracking-[0.05em] md:top-[22.93%] md:text-[clamp(32px,7.48cqw,64px)] md:leading-[1.094] md:tracking-[0.01em]"
      >
        {headline.split("\n").map((line) => (
          <span class="block whitespace-nowrap">{line}</span>
        ))}
      </h2>
    </div>

    <!-- On phones the text runs on and wraps by itself; wide screens keep the set lines. -->
    <p
      class="mx-auto mt-[178px] max-w-[300px] text-center font-sans text-[18px] leading-[22px] font-normal uppercase tracking-[0.06em] md:mt-[191px] md:max-w-[856px] md:text-[24px] md:leading-[1.2] md:tracking-[0.03em]"
    >
      {subtext.split("\n").map((line) => (
        <span class="md:block">{line} </span>
      ))}
    </p>
  </div>

  <div class="mt-[200px] md:mt-[240px] lg:mt-[400px]">
    <SuiteSlider slides={slides} />
  </div>
</section>

<script>
  // Depth of field while scrolling. With the gallery in the middle of the screen the
  // pictures sit exactly as designed. Scrolling down, all of them rise ahead of the page
  // and fall out of focus; scrolling back up, they sink and sharpen again.
  const FOCUS_FROM = 0.08; // share of the gallery's travel that stays fully in focus
  const FOCUS_TO = 0.6; // share at which the pictures are fully out of focus
  const DESIGN_WIDTH = 856;

  const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const pictures = [...gallery.querySelectorAll<HTMLElement>("[data-float]")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const update = () => {
      const view = window.innerHeight;
      const box = gallery.getBoundingClientRect();
      if (box.bottom < -view || box.top > view * 2) return;

      // 1 as the gallery enters at the bottom of the screen, 0 when centred, -1 as it leaves.
      const travel = reduced.matches
        ? 0
        : clamp((box.top + box.height / 2 - view / 2) / ((view + box.height) / 2), -1, 1);
      const defocus = clamp((Math.abs(travel) - FOCUS_FROM) / (FOCUS_TO - FOCUS_FROM), 0, 1);
      const scale = box.width / DESIGN_WIDTH;

      for (const picture of pictures) {
        const rest = Number(picture.dataset.blur);
        const blur = rest + defocus * (Number(picture.dataset.soft) - rest);
        const shift = travel * Number(picture.dataset.rise) * scale;

        picture.style.setProperty("--blur", `${blur.toFixed(1)}px`);
        picture.style.setProperty("--shift", `${shift.toFixed(1)}px`);
      }
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    reduced.addEventListener("change", update);
    update();
  });
</script>
