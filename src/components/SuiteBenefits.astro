---
interface Benefit {
  title: string;
  description: string;
  image?: string;
  imageAlt: string;
  href: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  ctaLabel?: string;
  items: Benefit[];
}

const { eyebrow, headline, ctaLabel = "Learn more", items } = Astro.props;
---

<section
  class="bg-gradient-to-b from-blush to-blush-light px-6 pb-24 pt-10 text-brand-ink md:pb-[240px]"
>
  <div class="mx-auto max-w-[1032px]">
    <header class="text-center">
      <p class="font-serif text-[16px] font-medium uppercase tracking-[0.08em] md:text-[18px]">
        {eyebrow}
      </p>

      <h2
        class="mt-5 font-sans text-[28px] leading-[1.23] font-light uppercase tracking-[0.02em] md:text-[42px]"
      >
        {headline.split("\n").map((line) => (
          <span class="block">{line}</span>
        ))}
      </h2>
    </header>

    <ul class="mt-16 grid gap-x-6 gap-y-16 sm:grid-cols-2 lg:mt-[120px] lg:grid-cols-3">
      {items.map((item) => (
        <li class="flex flex-col items-start gap-7">
          {item.image ? (
            <img
              src={item.image}
              alt={item.imageAlt}
              class="aspect-[328/430] w-full rounded-tr-[24px] object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="aspect-[328/430] w-full rounded-tr-[24px] bg-brand-ink/10"
              role="img"
              aria-label={item.imageAlt}
            />
          )}

          <div class="flex flex-col gap-4">
            <h3 class="font-sans text-[16px] font-medium uppercase leading-[22px] tracking-[0.03em]">
              {item.title}
            </h3>

            <p class="font-sans text-[14px] font-normal leading-[1.7] tracking-[0.02em]">
              {item.description.split("\n").map((line) => (
                <span class="xl:block">{line} </span>
              ))}
            </p>
          </div>

          <a
            href={item.href}
            class="border-b border-brand-ink/30 pb-1 font-sans text-[12px] font-medium uppercase leading-[14px] tracking-[0.13em] transition hover:border-brand-ink"
          >
            {ctaLabel}
            <span class="sr-only"> about {item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
