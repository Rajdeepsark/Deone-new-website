---
import Nav from "./Nav.astro";

interface Props {
  eyebrow?: string;
  name: string;
  body?: string;
  imageSrc: string;
  imageAlt: string;
  /** Which part of the picture phones keep in view, as a CSS background-position. */
  imagePosition?: string;
  /** Any CSS background laid over the picture, such as a scrim or tint. */
  overlay?: string;
}

const {
  eyebrow = "Suite",
  name,
  body,
  imageSrc,
  imageAlt,
  imagePosition = "29.6% center",
  overlay,
} = Astro.props;
---

<!--
  Parallax like the homepage: outer container is 200vh (100vh of scroll while pinned),
  inner sticky wrapper is 100svh. Above the image sits the original "top bar" area
  (teal-night background reserved for the nav via pt-24), and the image begins below
  it with the rounded top-right corner intact.
-->
<section
  data-suite-hero-container
  class="relative isolate w-full text-brand-cream"
  style="height: 200vh;"
>
  <div
    class="sticky top-0 h-[100svh] w-full overflow-hidden isolate bg-suite-night"
  >
    <!-- Image area starts below the nav bar (72px mobile / 96px desktop), rounded top-right corner preserved -->
    <div
      class="absolute inset-x-0 top-[88px] md:top-24 bottom-0 overflow-hidden rounded-tr-[32px] md:rounded-tr-[60px]"
    >
      <div
        data-suite-hero-bg
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-[calc(100%+80svh)] md:h-[calc(100%+50svh)] bg-cover bg-no-repeat [background-position:var(--focus)] md:bg-center will-change-transform brightness-[1.19] md:brightness-100"
        style={`background-image: url('${imageSrc}'); --focus: ${imagePosition};`}
      >
      </div>
      <!-- Stays put while the picture moves behind it. -->
      {overlay && <div aria-hidden="true" class="absolute inset-0" style={`background: ${overlay};`}></div>}
      <!-- Scrim: fades in as the body sentence reveals so caps text stays legible -->
      <div
        data-suite-hero-scrim
        aria-hidden="true"
        class="absolute inset-0 bg-black opacity-0 transition-opacity duration-200 ease-out"
      ></div>
    </div>

    <img
      src={imageSrc}
      alt={imageAlt}
      class="sr-only"
      fetchpriority="high"
      decoding="async"
    />

    <!-- Nav rides on top of the whole hero -->
    <Nav variant="light" />

    <!-- Title block: fades out as the user scrolls through the parallax zone -->
    <div
      data-suite-hero-title
      class="absolute inset-x-0 top-[calc(6rem_+_40.8svh)] -translate-y-1/2 px-6 text-center md:top-[48svh] transition-opacity duration-200 ease-out"
    >
      <p
        class="font-serif text-[18px] leading-[22px] font-medium uppercase tracking-[0.08em] text-brand-cream"
      >
        {eyebrow}
      </p>

      <h1
        class="mt-4 font-sans text-[40px] leading-[1.1] font-light uppercase tracking-[0.05em] text-brand-cream md:mt-2 md:tracking-[0.03em] md:text-[clamp(80px,8vw,120px)]"
      >
        {name}
      </h1>
    </div>

    {body && (
      <!-- Body sentence: fades in near the bottom as the title fades out -->
      <p
        data-suite-hero-body
        class="pointer-events-none absolute inset-x-0 bottom-[17svh] md:bottom-[14svh] px-4 mx-auto max-w-none md:max-w-[600px] text-center font-sans text-[13px] md:text-[18px] font-normal uppercase leading-[1.5] tracking-[0.06em] md:tracking-[0.08em] text-brand-cream opacity-0 transition-opacity duration-200 ease-out"
      >
        {body.split("\n").map((line) => (
          <span class="block">{line}</span>
        ))}
      </p>
    )}
  </div>
</section>

<script>
  const container = document.querySelector<HTMLElement>("[data-suite-hero-container]");
  const bg = document.querySelector<HTMLElement>("[data-suite-hero-bg]");
  const titleEl = document.querySelector<HTMLElement>("[data-suite-hero-title]");
  const bodyEl = document.querySelector<HTMLElement>("[data-suite-hero-body]");
  const scrimEl = document.querySelector<HTMLElement>("[data-suite-hero-scrim]");

  if (container && bg) {
    let raf = 0;
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
    const update = () => {
      raf = 0;
      const rect = container.getBoundingClientRect();
      const scrollable = container.offsetHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const scrolled = Math.max(0, Math.min(scrollable, -rect.top));
      const progress = scrolled / scrollable;

      // Parallax background
      const translate = progress * (window.innerHeight * 0.5);
      bg.style.transform = `translate3d(0, -${translate}px, 0)`;

      // Title fades out over the first half; body fades in over the second half.
      if (titleEl) {
        const titleOpacity = clamp(1 - progress / 0.5, 0, 1);
        titleEl.style.opacity = String(titleOpacity);
      }
      if (bodyEl) {
        const bodyOpacity = clamp((progress - 0.5) / 0.4, 0, 1);
        bodyEl.style.opacity = String(bodyOpacity);
      }
      if (scrimEl) {
        // Peak ~0.22 opacity when the body is fully revealed — enough to lift caps text.
        const scrimOpacity = clamp((progress - 0.5) / 0.4, 0, 1) * 0.22;
        scrimEl.style.opacity = String(scrimOpacity);
      }
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
