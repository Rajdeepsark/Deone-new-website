---
import Nav from "./Nav.astro";
import MenuButton from "./MenuButton.astro";

interface Props {
  eyebrow?: string;
  name: string;
  imageSrc: string;
  imageAlt: string;
}

const { eyebrow = "Suite", name, imageSrc, imageAlt } = Astro.props;
---

<section class="relative isolate w-full bg-brand-teal-night pt-24 text-brand-cream">
  <Nav variant="light" />

  <div
    class="relative aspect-square min-h-[calc(100svh-6rem)] w-full overflow-hidden rounded-tr-[32px] md:rounded-tr-[60px]"
  >
    <img
      src={imageSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover object-[28%_center] md:object-center"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="absolute inset-x-0 top-[48svh] -translate-y-1/2 px-6 text-center">
    <p
      class="font-serif text-[16px] md:text-[18px] font-medium uppercase tracking-[0.08em] text-brand-cream"
    >
      {eyebrow}
    </p>

    <h1
      class="mt-1 md:mt-2 font-sans text-[52px] leading-[1.1] font-light uppercase tracking-[0.03em] md:text-[80px] lg:text-[96px] xl:text-[120px] text-brand-cream"
    >
      {name}
    </h1>
  </div>

  <MenuButton />
</section>
