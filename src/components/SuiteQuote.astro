---
interface Props {
  text: string;
  image?: string;
  imageAlt?: string;
}

const { text, image, imageAlt = "" } = Astro.props;
---

<section
  class="relative isolate flex aspect-[1512/900] min-h-[520px] w-full items-center justify-center overflow-hidden bg-brand-teal-night px-6 text-brand-cream"
>
  {image && (
    <img
      src={image}
      alt={imageAlt}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  )}

  <p
    class="text-center font-serif text-[26px] leading-[1.27] font-normal uppercase tracking-[0.02em] md:text-[36px] xl:text-[44px]"
  >
    {text.split("\n").map((line) => (
      <span class="md:block">{line} </span>
    ))}
  </p>
</section>
