---
import { icons, type IconName } from "../icons";

interface Props {
  name: IconName;
  stroke?: number;
}

const { name, stroke = 1.3 } = Astro.props;
---

<svg
  class="h-5 w-5 flex-none overflow-visible"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
