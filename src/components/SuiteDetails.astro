---
type IconName = "card" | "coin" | "connect" | "travel" | "wellness" | "diamond";

interface Group {
  title: string;
  icon: IconName;
  items: string[];
}

interface Props {
  headline: string;
  subtext: string;
  groups: Group[];
}

const { headline, subtext, groups } = Astro.props;

// Drawn on a 20 x 20 grid with a 1.3 stroke, as in the design.
const icons: Record<IconName, string> = {
  card: `<rect x="0.65" y="3.65" width="18.7" height="12.7" rx="1.6" /><path d="M4 8.15h12M4 11.95h6" />`,
  coin: `<circle cx="10" cy="10" r="9.35" /><path d="M14.2 7.2c0-1.8-1.8-3-4.2-3s-4.2 1.2-4.2 3c0 4 8.4 1.6 8.4 5.6 0 1.8-1.8 3-4.2 3s-4.3-1.2-4.3-3.1M10 2.2v2M10 15.8v2" />`,
  connect: `<path d="M5.3 11.35h-.6c-2.2 0-4.05-1.6-4.05-3.7 0-1.9 1.4-3.5 3.3-3.75C4.7 1.95 6.7.65 9 .65c2.6 0 4.8 1.7 5.4 4.1 2.75.1 4.95 1.5 4.95 3.6 0 1.7-1.4 3-3.2 3h-1.4" /><path d="M10 19.35v-8.7M6.3 14.35 10 10.65l3.7 3.7" />`,
  travel: `<circle cx="15.35" cy="3.35" r="2.7" /><path d="M1.48 18.18Q.9 19.35 2.2 19.35h9.4q1.3 0 .72-1.17L7.48 8.37Q6.9 7.2 6.32 8.37Z" /><path d="M10.6 14.6l2.5-3.18q.8-1.02 1.45.1l3.9 6.71q.65 1.12-.65 1.12h-4.9" />`,
  wellness: `<path d="M8.7 1.75a5.35 5.35 0 1 0 0 8.5" /><path d="M11.3 6.6c1.9 0 3.6.9 4 2.6.4-1.7 2.1-2.6 4-2.6M15.3 9.2v1.5" /><path d="M.65 16.9c1.56 0 1.56 2.4 3.12 2.4s1.56-2.4 3.12-2.4 1.56 2.4 3.11 2.4 1.56-2.4 3.12-2.4 1.56 2.4 3.12 2.4 1.56-2.4 3.11-2.4" />`,
  diamond: `<path d="M4.77 2.38Q5.3 1.65 6.2 1.65h7.6q.9 0 1.43.73l3.59 4.89q.53.73-.06 1.41l-8.17 9.34q-.59.68-1.18 0L1.24 8.68Q.65 8 1.18 7.27Z" /><path d="M1 8h18M5.5 1.9 10 8l4.5-6.1M10 8v10.4" />`,
};
---

<section
  class="bg-gradient-to-b from-sand-warm to-blush-light px-6 pb-24 pt-24 text-brand-ink md:pb-[200px] md:pt-[160px]"
>
  <header class="mx-auto max-w-[680px] text-center lg:min-h-[158px]">
    <h2
      class="font-sans text-[28px] leading-[1.214] font-normal uppercase tracking-[0.02em] md:text-[42px]"
    >
      {headline}
    </h2>

    <p
      class="mx-auto mt-7 max-w-[610px] font-sans text-[16px] font-normal leading-[1.7] tracking-[0.01em]"
    >
      {subtext}
    </p>
  </header>

  <ul
    class="mx-auto mt-16 grid max-w-[1032px] gap-x-6 gap-y-14 sm:grid-cols-2 lg:mt-[200px] lg:grid-cols-3 lg:gap-y-24"
  >
    {groups.map((group) => (
      <li class="flex flex-col gap-4">
        <h3 class="flex items-center gap-5 font-sans text-[16px] font-medium uppercase leading-[22px] tracking-[0.03em]">
          <svg
            class="h-5 w-5 flex-none"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[group.icon]}
          />
          {group.title}
        </h3>

        <ul class="flex flex-col gap-3 pl-10 font-sans text-[14px] font-normal leading-6 tracking-[0.02em]">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
