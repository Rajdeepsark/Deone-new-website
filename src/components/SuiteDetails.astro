---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

interface Group {
  title: string;
  icon: IconName;
  items: string[];
}

interface Props {
  headline: string;
  subtext: string;
  groups: Group[];
}

const { headline, subtext, groups } = Astro.props;
---

<section
  class="bg-gradient-to-b from-sand-warm to-blush-light px-6 pb-24 pt-24 text-brand-ink md:pb-[200px] md:pt-[160px]"
>
  <header class="mx-auto max-w-[680px] text-center lg:min-h-[158px]">
    <h2
      class="font-sans text-[28px] leading-[1.214] font-normal uppercase tracking-[0.02em] md:text-[42px]"
    >
      {headline}
    </h2>

    <p
      class="mx-auto mt-7 max-w-[610px] font-sans text-[16px] font-normal leading-[1.7] tracking-[0.01em]"
    >
      {subtext}
    </p>
  </header>

  <ul
    class="mx-auto mt-16 grid max-w-[1032px] gap-x-6 gap-y-14 sm:grid-cols-2 lg:mt-[200px] lg:grid-cols-3 lg:gap-y-24"
  >
    {groups.map((group) => (
      <li class="flex flex-col gap-4">
        <h3 class="flex items-center gap-5 font-sans text-[16px] font-medium uppercase leading-[22px] tracking-[0.03em]">
          <Icon name={group.icon} />
          {group.title}
        </h3>

        <ul class="flex flex-col gap-3 pl-10 font-sans text-[14px] font-normal leading-6 tracking-[0.02em]">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
