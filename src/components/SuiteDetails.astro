---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

interface Group {
  title: string;
  icon: IconName;
  items: string[];
}

interface Props {
  headline: string;
  subtext: string;
  groups: Group[];
}

const { headline, subtext, groups } = Astro.props;
---

<section
  class="[background:var(--suite-details-bg)] [--color-suite-ink:var(--suite-details-ink)] px-4 py-[120px] text-suite-ink md:px-6 md:pb-[200px] md:pt-[160px]"
>
  <header class="mx-auto max-w-[680px] text-center lg:min-h-[158px]">
    <h2
      class="font-sans text-[30px] leading-[37px] font-normal uppercase tracking-[0.03em] md:text-[42px] md:leading-[1.214] md:tracking-[0.02em]"
    >
      {headline}
    </h2>

    <p
      class="mx-auto mt-8 max-w-[324px] font-sans text-[16px] font-normal leading-[27px] tracking-[0.01em] md:mt-7 md:max-w-[610px] md:leading-[1.7]"
    >
      {subtext}
    </p>
  </header>

  <!-- Phones: one centred column, each icon above its title. Wider: icons beside titles. -->
  <ul
    class="mx-auto mt-[120px] grid max-w-[1032px] gap-16 md:mt-16 md:grid-cols-2 md:gap-x-6 md:gap-y-14 lg:mt-[200px] lg:grid-cols-3 lg:gap-y-24"
  >
    {groups.map((group) => (
      <li class="flex flex-col items-center gap-4 text-center md:items-stretch md:text-left">
        <h3 class="flex flex-col items-center gap-5 font-sans text-[18px] font-normal uppercase leading-[22px] tracking-[0.06em] md:flex-row md:text-[16px] md:font-medium md:tracking-[0.03em]">
          <Icon name={group.icon} />
          {group.title}
        </h3>

        <ul class="flex flex-col gap-3 font-sans text-[14px] font-normal leading-[21px] md:pl-10 md:leading-6 md:tracking-[0.02em]">
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
