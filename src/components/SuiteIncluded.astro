---
interface Card {
  label?: string;
  size: "square" | "tall";
  image?: string;
  imageAlt: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  subtext: string;
  items: Card[];
}

const { eyebrow, headline, subtext, items } = Astro.props;

// Cards are listed column by column, so equal slices give the three columns.
const perColumn = Math.ceil(items.length / 3);
const columns = [0, 1, 2].map((i) => items.slice(i * perColumn, (i + 1) * perColumn));

// On wide screens the rounded corners mirror around the middle column.
const corners = [
  "rounded-tr-[24px]",
  "rounded-tr-[24px] lg:rounded-t-[24px]",
  "rounded-tr-[24px] lg:rounded-tl-[24px] lg:rounded-tr-none",
];
---

<section class="bg-blush-light px-6 py-24 text-brand-ink md:py-[160px]">
  <header class="text-center">
    <p
      class="font-serif text-[16px] leading-[22px] font-medium uppercase tracking-[0.08em] md:text-[18px]"
    >
      {eyebrow}
    </p>

    <h2
      class="mt-6 font-sans text-[28px] leading-[1.3] font-light uppercase tracking-[0.02em] md:text-[42px]"
    >
      {headline}
    </h2>

    <p
      class="mt-6 font-sans text-[14px] font-normal leading-[1.7] tracking-[0.01em] md:text-[16px]"
    >
      {subtext}
    </p>
  </header>

  <div
    class="mx-auto mt-16 max-w-[1032px] columns-1 gap-6 sm:columns-2 lg:mt-[120px] lg:flex lg:columns-auto"
  >
    {columns.map((cards, column) => (
      <ul class="contents lg:flex lg:flex-1 lg:flex-col lg:gap-6">
        {cards.map((card) => (
          <li
            class:list={[
              "relative isolate mb-6 break-inside-avoid overflow-hidden bg-brand-ink lg:mb-0",
              card.size === "tall" ? "aspect-[328/431]" : "aspect-square",
              corners[column],
            ]}
          >
            {card.image ? (
              <img
                src={card.image}
                alt={card.imageAlt}
                class="absolute inset-0 -z-10 h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="sr-only">{card.imageAlt}</span>
            )}

            {card.label && (
              <p class="absolute inset-x-0 bottom-0 bg-gradient-to-b from-transparent to-black/40 px-6 pb-6 pt-8 font-sans text-[16px] font-medium leading-[1.7] tracking-[0.01em] text-brand-sand">
                {card.label.split("\n").map((line) => (
                  <span class="block">{line}</span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
