---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Inline style for <body>; suite pages use it to set their palette's CSS variables. */
  bodyStyle?: string;
}

const {
  title = "DeOne",
  description = "Crafted global banking, a members-only experience made to do more for you.",
  bodyStyle,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,300;0,400;0,500;0,600&family=Montserrat:wght@200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body style={bodyStyle || undefined}>
    <slot />
  </body>
</html>
