---
import Base from "../layouts/Base.astro";

const year = new Date().getFullYear();
---

<!--
  The sign-in page in front of the whole site while it is private. The middleware
  (middleware.js, at the project root) sends anyone without the access cookie here and
  checks what this form posts back. It wears the full-screen menu's look: teal, the cream
  doors closing in from either side, the logo above, and the closing banner's button.
  The address may carry ?next= (where to go after signing in) and ?error (a wrong try).
-->
<Base title="DeOne | Sign in" description="DeOne is private for now. Sign in to continue.">
  <main class="access relative isolate flex min-h-svh flex-col items-center overflow-hidden bg-brand-teal px-6 text-brand-cream">
    <img
      src="/footer-pattern.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
      decoding="async"
    />

    <!-- The menu's doors, sized here so the form always has room between them -->
    <div
      aria-hidden="true"
      class="door door-left pointer-events-none absolute left-0 top-5 bottom-5 -z-10 bg-brand-cream rounded-tr-[162px] rounded-br-[162px] md:top-0 md:bottom-0"
    >
    </div>
    <div
      aria-hidden="true"
      class="door door-right pointer-events-none absolute right-0 top-5 bottom-5 -z-10 bg-brand-cream rounded-tl-[162px] rounded-bl-[162px] md:top-0 md:bottom-0"
    >
    </div>

    <svg
      class="rise mt-16 h-6 w-auto shrink-0 md:mt-14 md:h-7"
      viewBox="0 0 153 28"
      fill="currentColor"
      role="img"
      aria-label="DeOne"
    >
      <path d="M21.5144 9.36398C21.0125 8.19821 20.319 7.21283 19.434 6.40514C18.5462 5.60014 17.51 4.98629 16.3254 4.5636C15.1408 4.1436 13.8537 3.93359 12.464 3.93359H0V22.7044H12.464C13.5703 22.7044 14.6146 22.5698 15.5995 22.2978C16.5844 22.0259 17.483 21.6274 18.3006 21.1024C19.1183 20.5774 19.8198 19.9367 20.4081 19.1828C20.9963 18.429 21.4524 17.5621 21.7789 16.5794C22.1027 15.5967 22.2673 14.5117 22.2673 13.319C22.2673 11.8463 22.0163 10.5271 21.5171 9.36129L21.5144 9.36398ZM17.5235 15.5428C17.313 16.1998 17.0216 16.7732 16.6546 17.2659C16.2849 17.7559 15.8505 18.1651 15.3513 18.4882C14.8494 18.814 14.307 19.0536 13.7187 19.2124C13.1305 19.3713 12.5287 19.4494 11.9135 19.4494H5.31857C4.72492 19.4494 4.2446 18.9701 4.2446 18.3778V8.27091C4.2446 7.6786 4.72492 7.19936 5.31857 7.19936H11.9135C12.6852 7.19936 13.43 7.32321 14.1397 7.56821C14.8521 7.81321 15.4889 8.19014 16.0502 8.69898C16.6114 9.20783 17.0513 9.84591 17.367 10.6186C17.6827 11.3913 17.8419 12.2932 17.8419 13.3271C17.8419 14.1509 17.7367 14.8913 17.5262 15.5482L17.5235 15.5428Z" />
      <path d="M33.0582 22.7068V3.93604H51.0809V7.19642H38.3741C37.7805 7.19642 37.3001 7.67565 37.3001 8.26796V11.6387H50.0285V14.7672H37.3001V18.3749C37.3001 18.9672 37.7805 19.4464 38.3741 19.4464H51.0809V22.7068H33.0582Z" />
      <path d="M134.958 22.7068V3.93604H152.981V7.19642H140.274C139.681 7.19642 139.2 7.67565 139.2 8.26796V11.6387H151.929V14.7672H139.2V18.3749C139.2 18.9672 139.681 19.4464 140.274 19.4464H152.981V22.7068H134.958Z" />
      <path d="M119.41 5.00783V17.6671L108.498 4.91629C107.964 4.29437 107.184 3.93359 106.363 3.93359H102.783V22.7044H105.557C106.15 22.7044 106.631 22.2251 106.631 21.6328V8.93321L117.57 21.7217C118.104 22.3463 118.884 22.7044 119.704 22.7044H123.285V3.93359H120.487C119.893 3.93359 119.413 4.41283 119.413 5.00514L119.41 5.00783Z" />
      <path d="M90.9607 13.0198C90.9095 9.5036 89.8625 0.126295 76.4892 0.0966797C63.1185 0.126295 62.0688 9.5036 62.0176 13.0198C62.0176 13.3536 62.0176 14.6486 62.0176 14.9825C62.0688 18.4986 63.1158 27.8759 76.4892 27.9055C89.8598 27.8759 90.9095 18.4986 90.9607 14.9825C90.9607 14.8209 90.9607 13.1274 90.9607 13.0198ZM86.2331 14.6782C86.2331 17.0609 85.7663 24.3705 76.4919 24.4809C67.2174 24.3705 66.7506 17.0609 66.7506 14.6782V13.324C66.7506 10.9413 67.2174 3.63168 76.4919 3.5213C85.7663 3.63168 86.2331 10.9413 86.2331 13.324V14.6782Z" />
    </svg>

    <section class="panel rise rise-late flex flex-1 flex-col justify-center py-16 text-center">
      <p class="font-serif text-[16px] font-medium uppercase tracking-[0.28em] md:text-[18px]">
        Private Preview
      </p>

      <h1 class="mt-4 font-sans text-[28px] font-light uppercase leading-[1.2] tracking-[0.04em] md:text-[32px]">
        Welcome to DeOne
      </h1>

      <p class="mx-auto mt-5 max-w-[300px] font-sans text-[14px] leading-[1.7] tracking-[0.01em] text-brand-cream/80 md:text-[16px]">
        The site is private for now. Sign in with the details you were given.
      </p>

      <form method="post" action="/access" class="mt-12 flex flex-col gap-8 text-left" data-access-form>
        <input type="hidden" name="next" value="/" />

        <label class="block">
          <span class="field-label">Username</span>
          <input
            type="text"
            name="username"
            required
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            class="field"
          />
        </label>

        <label class="block">
          <span class="field-label">Password</span>
          <span class="relative block">
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
              class="field pr-16"
              data-access-password
            />
            <button
              type="button"
              aria-pressed="false"
              aria-label="Show password"
              class="absolute right-0 bottom-3 cursor-pointer font-sans text-[11px] font-medium uppercase tracking-[0.13em] text-brand-cream/70 transition-colors duration-300 hover:text-brand-cream"
              data-access-reveal
            >
              Show
            </button>
          </span>
        </label>

        <p
          role="alert"
          hidden
          class="-mt-2 font-sans text-[14px] leading-[1.6] tracking-[0.01em] text-pretty text-blush"
          data-access-error
        >
          That username or password isn't right. Please try again.
        </p>

        <!-- The closing banner's button, filling the form's width -->
        <button
          type="submit"
          class="group mt-2 inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-lg border border-brand-cream/80 transition-colors duration-300 hover:border-brand-cream hover:bg-brand-cream/10"
        >
          <span class="inline-flex items-center font-sans text-[12px] font-medium uppercase tracking-[0.13em] text-brand-cream/90 transition-colors duration-300 group-hover:text-brand-cream">
            Sign in
            <span aria-hidden="true" class="inline-flex max-w-0 items-center overflow-hidden opacity-0 transition-all duration-300 ease-out group-hover:ml-2 group-hover:max-w-[24px] group-hover:opacity-100">
              <svg width="17" height="17" viewBox="0 0 17 17" fill="none">
                <path d="M0 8.5 H6 M8 8.5 H14" stroke="currentColor" stroke-width="1" />
                <path d="M11 4 L16 8.5 L11 13" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </span>
          </span>
        </button>
      </form>
    </section>

    <p class="rise rise-late pb-8 font-sans text-[12px] font-normal tracking-[0.02em] opacity-90">
      © {year} DeOne. All rights reserved.
    </p>
  </main>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const form = document.querySelector<HTMLFormElement>("[data-access-form]");
  const password = document.querySelector<HTMLInputElement>("[data-access-password]");
  const reveal = document.querySelector<HTMLButtonElement>("[data-access-reveal]");
  const error = document.querySelector<HTMLElement>("[data-access-error]");

  // Carry on to the page they came for once signed in; the middleware checks it stays on
  // this site.
  const next = form?.elements.namedItem("next");
  if (next instanceof HTMLInputElement) next.value = params.get("next") || "/";

  if (params.has("error") && error) {
    error.hidden = false;
    password?.focus();
  }

  reveal?.addEventListener("click", () => {
    if (!password) return;
    const show = password.type === "password";
    password.type = show ? "text" : "password";
    reveal.textContent = show ? "Hide" : "Show";
    reveal.setAttribute("aria-pressed", String(show));
    reveal.setAttribute("aria-label", show ? "Hide password" : "Show password");
  });
</script>

<style>
  /* The doors are the menu's, at its 533px on wide screens, but narrow as the screen does
     so the form keeps 600px between them; on phones they are slim strips at the edges. */
  .access {
    --door: 9vw;
  }
  @media (min-width: 768px) {
    .access {
      --door: min(533px, calc((100vw - 600px) / 2));
    }
  }
  .door {
    width: var(--door);
  }
  .panel {
    width: min(360px, calc(100vw - 2 * var(--door) - 48px));
  }

  /* Labels in the site's small capitals; fields drawn as a single line, like the rules
     under the footer headings. */
  .field-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: color-mix(in oklab, var(--color-brand-cream) 70%, transparent);
  }
  .field {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 0 0 12px;
    border: 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-brand-cream) 40%, transparent);
    background: transparent;
    color: var(--color-brand-cream);
    caret-color: var(--color-brand-cream);
    font-family: var(--font-sans);
    font-size: 16px;
    letter-spacing: 0.02em;
    border-radius: 0;
    outline: none;
    transition: border-color 300ms;
  }
  .field:hover {
    border-bottom-color: color-mix(in oklab, var(--color-brand-cream) 70%, transparent);
  }
  .field:focus {
    border-bottom-color: var(--color-brand-cream);
  }
  /* Browsers paint saved details on a pale box; keep them on the teal instead. */
  .field:-webkit-autofill {
    -webkit-text-fill-color: var(--color-brand-cream);
    -webkit-box-shadow: 0 0 0 1000px var(--color-brand-teal) inset;
    transition: background-color 9999s;
  }

  /* On arrival the doors slide in as the menu's do, then the words rise into place. */
  .door-left {
    animation: door-in-left 700ms cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  .door-right {
    animation: door-in-right 700ms cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  .rise {
    animation: rise 600ms ease-out 200ms both;
  }
  .rise-late {
    animation-delay: 350ms;
  }
  @keyframes door-in-left {
    from {
      transform: translateX(-100%);
    }
  }
  @keyframes door-in-right {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .door-left,
    .door-right,
    .rise {
      animation: none;
    }
  }
</style>
