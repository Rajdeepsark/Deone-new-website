---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SuiteHero from "../../components/SuiteHero.astro";
import SuitePictures from "../../components/SuitePictures.astro";
import SuiteBenefits from "../../components/SuiteBenefits.astro";
import SuiteQuote from "../../components/SuiteQuote.astro";
import SuiteSecurity from "../../components/SuiteSecurity.astro";
import SuiteIncluded from "../../components/SuiteIncluded.astro";
import SuiteDetails from "../../components/SuiteDetails.astro";
import SuiteNext from "../../components/SuiteNext.astro";
import Menu from "../../components/Menu.astro";

export async function getStaticPaths() {
  const suites = await getCollection("suites");
  return suites.map((suite) => ({
    params: { slug: suite.id },
    props: { suite },
  }));
}

const { suite } = Astro.props;
const {
  name,
  description,
  theme,
  hero,
  pictures,
  benefits,
  quote,
  security,
  included,
  details,
  next,
} = suite.data;

// The suite's colours become CSS variables on <body>. Each section reads its own
// --suite-<section>-bg and --suite-<section>-ink; whatever the YAML leaves out keeps the
// Prestige defaults from src/styles/global.css.
const sections = ["pictures", "benefits", "security", "included", "details"] as const;
const cssVariables: string[] = [];
for (const key of sections) {
  const section = theme[key];
  if (section?.background) cssVariables.push(`--suite-${key}-bg: ${section.background}`);
  if (section?.ink) cssVariables.push(`--suite-${key}-ink: ${section.ink}`);
}
const includedPhone = theme.included?.backgroundPhone ?? theme.included?.background;
if (includedPhone) cssVariables.push(`--suite-included-bg-phone: ${includedPhone}`);
if (theme.accent) cssVariables.push(`--color-suite-accent: ${theme.accent}`);
if (theme.night) cssVariables.push(`--color-suite-night: ${theme.night}`);
const bodyStyle = cssVariables.join("; ");
---

<Base title={`DeOne | ${name}`} description={description} bodyStyle={bodyStyle}>
  <SuiteHero
    eyebrow={hero.eyebrow}
    name={name}
    imageSrc={hero.image}
    imageAlt={hero.imageAlt}
  />
  <SuitePictures
    headline={pictures.headline}
    subtext={pictures.subtext}
    gallery={pictures.gallery}
    slides={pictures.slides}
  />
  <SuiteBenefits
    eyebrow={benefits.eyebrow}
    headline={benefits.headline}
    items={benefits.items}
  />
  <SuiteQuote text={quote.text} image={quote.image} imageAlt={quote.imageAlt} />
  <SuiteSecurity
    eyebrow={security.eyebrow}
    headline={security.headline}
    subtext={security.subtext}
    tabs={security.tabs}
  />
  <SuiteIncluded
    eyebrow={included.eyebrow}
    headline={included.headline}
    subtext={included.subtext}
    items={included.items}
    phone={included.phone}
  />
  <SuiteDetails headline={details.headline} subtext={details.subtext} groups={details.groups} />
  {next && (
    <SuiteNext
      eyebrow={next.eyebrow}
      name={next.name}
      ctaLabel={next.ctaLabel}
      href={next.href}
      color={next.color}
      image={next.image}
      imageAlt={next.imageAlt}
    />
  )}

  <!-- Fixed floating menu toggle — same markup as the homepage Hero uses -->
  <button
    type="button"
    data-menu-toggle
    aria-label="Open menu"
    class="group fixed left-1/2 top-[92svh] z-40 flex h-11 w-[130px] md:w-[190px] -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center gap-[6px] rounded-lg bg-overlay-dark/80 backdrop-blur-sm text-brand-cream transition hover:bg-overlay-dark/95"
  >
    <span class="block h-px w-[90px] bg-current transition-[width] duration-300 ease-out group-hover:w-[110px] md:group-hover:w-[140px]"></span>
    <span class="block h-px w-[90px] bg-current transition-[width] duration-300 ease-out group-hover:w-[110px] md:group-hover:w-[140px]"></span>
  </button>

  <Menu />
</Base>
